---
import './header.css';
const { origin } = Astro.props;
import Logo from '../Logo.astro';
import SocialIcons from '../SocialIcons.astro';

---

<header class="header">
	<div class="header__container">
		<Logo name="Amel M" />
		<nav class="links" tabindex="0.1" id="menu">
			<button class="menu__btn" id="menuToggle">☰</button>
			<ul class="header__list">
				{
					origin.map((data) => (
						<li>
							<a class="menu__link" href={data.link} data-section={data.link.replace("#", "")}>
								<span class="icon__container" >
									<iconify-icon
										class="icons"
										icon={data.icon}
										width="20"
										height="20"
									/>
									{data.content}
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<SocialIcons width="25" height="25"/>
		</nav>
	</div>
	<div id="mobile-menu" class="hidden md:hidden bg-white shadow-md">
            <ul class="header__list-responsive">
				{
					origin.map((data) => (
						<li>
							<a class="menu__link" href={data.link} data-section={data.link.replace("#", "")}>
								<span class="icon__container" >
									{data.content}
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<SocialIcons width="25" height="25"/>
        </div>
</header>


    <script>
        const menuBtn = document.getElementById('menuToggle');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn?.addEventListener('click', () => {
            mobileMenu?.classList.toggle('hidden');
        });
    </script>
